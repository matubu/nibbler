{
	"$schema": "./web/node_modules/wrangler/config-schema.json",
	"name": "snake",
	"compatibility_date": "2026-10-01",
	// The custom domain is provisioned by wrangler on deploy (the mathias.ninja zone is on Cloudflare)
	"routes": [{ "pattern": "snake.mathias.ninja", "custom_domain": true }],
	// Run by `wrangler deploy`, so Workers Builds only needs its default deploy command
	"build": { "command": "npm --prefix web ci && npm --prefix web run build" },
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application"
	}
}
